<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sanni Yakuma · {{ r.repo }}</title>
<meta name="description" content="An exorcism for the code of {{ r.repo }}, after the Sanni Yakuma healing ritual of southern Sri Lanka.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Sinhala:wght@400;600&display=swap" rel="stylesheet">
<style>
{% include "_base.css" %}

/* Opening */
header.stage { text-align: center; padding-top: clamp(48px, 12vh, 140px); padding-bottom: clamp(24px, 6vh, 70px); }
header.stage h1 { font-size: clamp(2.2rem, 6vw, 4rem); margin: .3em 0 .2em; word-break: break-word; }
header.stage .lede { font-size: 1.15rem; color: var(--dim); max-width: 36em; margin: 0 auto 1.5em; }
.meta { font-size: .9rem; color: var(--dim); }
.meta span + span::before { content: " · "; }
.tally { margin-top: 2.2em; font-size: 1.1rem; }
.tally strong { color: var(--gold); font-weight: normal; font-size: 1.6rem; }

section { padding: clamp(40px, 9vh, 110px) 0 clamp(20px, 4vh, 50px); }
section > h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); margin: .2em 0 .4em; }
section > .intro { color: var(--dim); max-width: 40em; }

/* Ata Paliya: blessings as oil lamps */
.lamps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
.lamp { background: var(--wood); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px 18px; }
.lamp svg { width: 54px; height: 54px; display: block; }
.lamp .flame { fill: #4a3626; transition: fill 1.2s, filter 1.2s; }
.lamp.lit .flame, .no-js .lamp .flame { fill: var(--gold); filter: drop-shadow(0 0 8px var(--ember)); }
.lamp h3 { font-size: 1.1rem; margin: .4em 0 .2em; color: var(--gold); }
.lamp p { margin: 0; font-size: .95rem; color: var(--cream); }

/* Daha Ata Sanniya: the demons */
.demon { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; padding: clamp(32px, 7vh, 90px) 0; border-top: 1px solid var(--line); }
.demon .body { min-width: 0; }
.demon .mask svg { width: 100%; height: auto; filter: drop-shadow(0 10px 24px rgba(226,113,29,.25)); }
.demon h3 { font-size: 2rem; margin: 0; }
.demon .illness { color: var(--dim); margin: .2em 0 .6em; }
.flames { display: flex; gap: 4px; align-items: center; margin-bottom: 1em; font-size: .9rem; color: var(--dim); }
.flames svg { width: 16px; height: 21px; fill: var(--ember); }
.flames svg.off { fill: #3a2a1f; }
.flames span { margin-left: 8px; font-variant: small-caps; letter-spacing: .08em; }
blockquote.monologue {
  margin: 0 0 1.2em; padding: .2em 0 .2em 1em; border-left: 3px solid var(--red);
  font-style: italic; font-size: 1.12rem;
}
details { margin: 0 0 1.2em; }
summary { cursor: pointer; color: var(--gold); }
.evidence { list-style: none; padding: 0; margin: .6em 0 0; font-size: .92rem; }
.evidence li { padding: 6px 0; border-bottom: 1px dashed var(--line); }
.evidence .eid { color: var(--dim); font: .8em var(--mono); margin-right: .5em; }
.evidence .note { color: var(--dim); }
.exorcism { background: #13261a; border: 1px solid #2d4a33; border-radius: 10px; padding: 14px 18px; }
.exorcism h4 { margin: 0 0 .3em; color: #9fd39a; font-variant: small-caps; letter-spacing: .1em; font-size: 1rem; }
.exorcism p { margin: 0 0 .5em; }
.exorcism ol { margin: 0 0 .5em; padding-left: 1.3em; }
pre.diff { margin: .8em 0 0; padding: 12px; overflow-x: auto; background: #0b0f0b; border-radius: 6px; font: 13px/1.5 var(--mono); }
pre.diff .add { color: #8fdc8a; } pre.diff .del { color: #ef8a80; }
pre.diff .hunk { color: #7aa6d6; } pre.diff .file { color: var(--dim); } pre.diff .ctx { color: #c9bda8; }
pre.diff span { display: block; white-space: pre; }
.none { color: var(--dim); font-style: italic; }

/* The spared */
.spared { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 16px; list-style: none; padding: 0; }
.spared li { display: flex; gap: 10px; align-items: center; font-size: .88rem; color: var(--dim); }
.spared svg { width: 56px; flex: none; opacity: .75; }
.spared strong { color: var(--cream); font-weight: normal; display: block; }

/* Kola Sanniya */
#kola { text-align: center; }
#kola .mask svg { width: min(360px, 80vw); height: auto; filter: drop-shadow(0 12px 40px rgba(179,38,30,.45)); }
#kola .root { font-size: 1.35rem; max-width: 30em; margin: .6em auto; color: var(--gold); }
#kola .explanation { max-width: 36em; margin: 0 auto; color: var(--cream); }
.verse { margin: 3em auto 0; max-width: 34em; padding: 24px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.verse .si { font: 1.5rem/1.8 var(--sinhala); margin: 0; white-space: pre-line; }
.verse .tr { color: var(--dim); font-style: italic; margin: .8em 0 .3em; white-space: pre-line; }
.verse .en { margin: 0; white-space: pre-line; }

footer { padding: clamp(40px, 8vh, 100px) 22px clamp(50px, 10vh, 120px); color: var(--dim); font-size: .92rem; border-top: 1px solid var(--line); margin-top: 6vh; }
footer h2 { color: var(--cream); font-size: 1.3rem; }
footer ul { padding-left: 1.2em; }

/* The opening stage: Kola Sanniya presides between two torches, embers rising. */
header.stage { padding-top: clamp(24px, 6vh, 70px); }
.stage-set { position: relative; display: flex; align-items: flex-end; justify-content: center; gap: clamp(8px, 4vw, 56px); margin: 0 auto 8px; }
.stage-set .hero-mask svg { width: min(340px, 58vw); height: auto; display: block; filter: drop-shadow(0 18px 50px rgba(179,38,30,.5)); }
.torch { width: clamp(34px, 6vw, 60px); height: auto; overflow: visible; }
.torch .flame-outer, .torch .flame-inner { transform-box: fill-box; transform-origin: 50% 100%; }
.torch .flame-outer { animation: flame 1.3s ease-in-out infinite alternate; filter: drop-shadow(0 0 14px rgba(226,113,29,.9)); }
.torch .flame-inner { animation: flame .8s ease-in-out infinite alternate-reverse; }
@keyframes flame {
  0% { transform: scale(1, 1) skewX(0); } 50% { transform: scale(.93, 1.09) skewX(-3deg); } 100% { transform: scale(1.05, .94) skewX(2deg); }
}
.embers { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.ember { position: absolute; bottom: 10%; width: 3px; height: 3px; border-radius: 50%; background: #f6c453;
  box-shadow: 0 0 6px 2px rgba(226,113,29,.8); opacity: 0; animation: rise linear infinite; }
@keyframes rise {
  0% { transform: translate(0, 0); opacity: 0; } 10% { opacity: 1; }
  100% { transform: translate(var(--drift), -60vh); opacity: 0; }
}

/* Sending a demon away: the mask turns to smoke and leaves the stage. */
.banish { margin-top: 14px; font: 1rem var(--serif); color: var(--night); background: var(--gold); border: 0; border-radius: 999px;
  padding: 9px 20px; cursor: pointer; box-shadow: 0 0 0 0 rgba(224,165,38,.6); animation: call 2.4s infinite; }
.banish:hover { background: #f6c453; }
.banish:focus-visible { outline: 2px solid var(--cream); outline-offset: 3px; }
.banish[disabled] { background: #2d4a33; color: #9fd39a; cursor: default; animation: none; }
@keyframes call { 0% { box-shadow: 0 0 0 0 rgba(224,165,38,.5); } 70%, 100% { box-shadow: 0 0 0 14px rgba(224,165,38,0); } }
.no-js .banish, .no-js .remaining { display: none; }
.demon .mask { position: relative; }
.demon.banished .mask svg { animation: depart 1.8s ease-in forwards; }
@keyframes depart {
  0% { transform: none; filter: none; opacity: 1; }
  25% { transform: translateY(-8px) rotate(-5deg); }
  100% { transform: translate(40px, -110px) rotate(14deg) scale(.55); filter: blur(7px) grayscale(1); opacity: 0; }
}
.puff { position: absolute; left: 50%; top: 45%; width: 70px; height: 70px; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, rgba(225,214,195,.6), rgba(225,214,195,0) 70%); animation: puff 1.9s ease-out forwards; }
@keyframes puff {
  from { transform: translate(-50%, -50%) scale(.3); opacity: .95; }
  to { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(2.6); opacity: 0; }
}
.demon.banished .mask::after { content: attr(data-gone); position: absolute; left: 0; right: 0; top: 40%; text-align: center;
  color: var(--dim); font-style: italic; opacity: 0; animation: appear 1s 1.5s forwards; }
@keyframes appear { to { opacity: 1; } }
.demon.banished .exorcism { border-color: #4f8a5a; box-shadow: 0 0 34px rgba(159,211,154,.22); transition: box-shadow 1s, border-color 1s; }
.remaining { color: var(--gold); margin-top: 1em; }
.all-gone #kola .mask svg { filter: drop-shadow(0 12px 60px rgba(224,165,38,.6)); transition: filter 2s; }

/* Long code and paths must wrap, never widen the page on a phone. */
.evidence li, .lamp p, .exorcism li, .exorcism p { overflow-wrap: anywhere; }

/* Demons walk on as you scroll (only when JS runs). */
.js .reveal { opacity: 0; transform: translateY(40px); transition: opacity 1s ease, transform 1s ease; }
.js .reveal.seen { opacity: 1; transform: none; }

@media (max-width: 680px) {
  .demon { grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .demon .mask svg { width: 170px; }
}
@media (prefers-reduced-motion: reduce) {
  body::before, body::after { animation: none; }
  .js .reveal { opacity: 1; transform: none; transition: none; }
  .lamp .flame { transition: none; }
  .torch .flame-outer, .torch .flame-inner, .ember, .banish { animation: none; }
  .ember { display: none; }
  .demon.banished .mask svg { animation: none; opacity: .15; }
  .puff { display: none; }
}
</style>
</head>
<body class="no-js">
<script>document.body.classList.remove("no-js"); document.documentElement.classList.add("js");</script>

<header class="stage">
  <div class="stage-set">
    <div class="embers" aria-hidden="true">
      {% for i in range(16) %}<span class="ember" style="left: {{ 8 + (i * 37) % 84 }}%; --drift: {{ ((i * 23) % 60) - 30 }}px; animation-duration: {{ 5 + (i % 5) }}s; animation-delay: -{{ (i * 0.9) % 7 }}s"></span>{% endfor %}
    </div>
    <svg class="torch" viewBox="0 0 60 230" aria-hidden="true">
        <g class="flame-outer"><path d="M30,6 C46,34 52,56 43,76 C38,87 22,87 17,76 C8,56 14,34 30,6 Z" fill="#e2711d"/></g>
        <g class="flame-inner"><path d="M30,30 C39,46 41,60 36,72 C33,78 27,78 24,72 C19,60 21,46 30,30 Z" fill="#f6c453"/></g>
        <path d="M14,80 L46,80 L41,97 L19,97 Z" fill="#6b3a1f" stroke="#1d1a17" stroke-width="2"/>
        <rect x="26" y="97" width="8" height="128" fill="#5a3418" stroke="#1d1a17" stroke-width="2"/>
      </svg>
    <div class="hero-mask sway">{{ kola_mask }}</div>
    <svg class="torch" viewBox="0 0 60 230" aria-hidden="true">
        <g class="flame-outer"><path d="M30,6 C46,34 52,56 43,76 C38,87 22,87 17,76 C8,56 14,34 30,6 Z" fill="#e2711d"/></g>
        <g class="flame-inner"><path d="M30,30 C39,46 41,60 36,72 C33,78 27,78 24,72 C19,60 21,46 30,30 Z" fill="#f6c453"/></g>
        <path d="M14,80 L46,80 L41,97 L19,97 Z" fill="#6b3a1f" stroke="#1d1a17" stroke-width="2"/>
        <rect x="26" y="97" width="8" height="128" fill="#5a3418" stroke="#1d1a17" stroke-width="2"/>
      </svg>
  </div>
  <p class="kicker">Sanni Yakuma · an exorcism for code</p>
  <h1>{{ r.repo }}</h1>
  <p class="lede">
    In the healing ritual of southern Sri Lanka, masked dancers call out the eighteen Sanni demons,
    each the cause of an illness, mock them, and send them away. Tonight the patient is a codebase.
  </p>
  <p class="meta">
    {% if repo_url %}<span><a href="{{ repo_url }}">{{ repo_url | replace("https://", "") }}</a></span>{% endif %}
    {% if short_commit %}<span>commit <code>{{ short_commit }}</code></span>{% endif %}
    <span>{{ date }}</span>
    <span>diagnosed by {{ r.model }}</span>
  </p>
  <p class="tally">
    <strong>{{ r.blessings | length }}</strong> blessings ·
    <strong>{{ demons | length }}</strong> of 18 demons found ·
    <strong>{{ clean | length }}</strong> never came near
  </p>
</header>

<main>
  <section id="ata-paliya">
    <p class="kicker">Ata Paliya</p>
    <h2>First, the blessings</h2>
    <p class="intro">
      The ritual does not begin with demons. It begins with dances that bring blessings.
      So here is what this repository already does well.
    </p>
    {% if r.blessings %}
    <ul class="lamps">
      {% for b in r.blessings %}
      <li class="lamp reveal">
        <svg viewBox="0 0 60 60" aria-hidden="true">
          <path class="flame" d="M30,6 Q40,20 31,31 Q21,21 30,6 Z"/>
          <path d="M6,34 Q30,29 54,34 Q50,49 30,51 Q10,49 6,34 Z" fill="#8a4b2a" stroke="#1d1a17" stroke-width="2"/>
        </svg>
        <h3>{{ b.title }}</h3>
        <p>{{ b.detail | ticks }}</p>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="none">No blessings were spoken.</p>
    {% endif %}
  </section>

  <section id="daha-ata-sanniya">
    <p class="kicker">Daha Ata Sanniya</p>
    <h2>The demons come out</h2>
    <p class="intro">
      One by one, each demon steps into the torchlight, boasts of what it has done, is mocked,
      and agrees to leave. Every claim below rests on evidence found in the code itself.
    </p>
    {% if demons %}<p class="remaining" aria-live="polite" data-count="{{ demons | length }}">{{ demons | length }} {{ "demon remains" if demons | length == 1 else "demons remain" }}. Read each cure, then send the demon away.</p>{% endif %}

    {% for d in demons %}
    <article class="demon reveal" id="{{ d.p.demon | lower | replace(' ', '-') }}">
      <div class="mask" data-gone="{{ d.p.demon }} has left the patient."><div class="sway" style="animation-delay: -{{ loop.index * 1.3 }}s">{{ d.mask }}</div></div>
      <div class="body">
        <h3>{{ d.p.demon }} Sanniya</h3>
        <p class="illness">brings {{ d.info.illness }} · in code: <em>{{ d.info.sickness }}</em></p>
        <div class="flames" aria-label="severity {{ d.p.severity }} of 3">
          {% for i in range(3) %}
          <svg viewBox="0 0 20 26" class="{{ '' if i < d.p.severity else 'off' }}" aria-hidden="true"><path d="M10,1 Q18,12 15,19 Q12,25 10,25 Q8,25 5,19 Q2,12 10,1 Z"/></svg>
          {% endfor %}
          <span>{{ d.severity }}</span>
        </div>
        <blockquote class="monologue">{{ d.p.monologue | ticks }}</blockquote>

        {% if d.evidence %}
        <details>
          <summary>The evidence ({{ d.evidence | length }})</summary>
          <ul class="evidence">
            {% for eid, ev, url in d.evidence %}
            <li>
              <span class="eid">{{ eid }}</span>
              {% if ev.path %}
                {% if url %}<a href="{{ url }}"><code>{{ ev.path }}{% if ev.line %}:{{ ev.line }}{% endif %}</code></a>
                {% else %}<code>{{ ev.path }}{% if ev.line %}:{{ ev.line }}{% endif %}</code>{% endif %}
              {% endif %}
              {% if ev.snippet %}<code>{{ ev.snippet }}</code>{% endif %}
              {% if ev.note %}<span class="note">{{ ev.note }}</span>{% endif %}
            </li>
            {% endfor %}
          </ul>
        </details>
        {% endif %}

        <div class="exorcism">
          <h4>The exorcism</h4>
          <p>{{ d.p.exorcism.summary | ticks }}</p>
          <ol>
            {% for step in d.p.exorcism.steps %}<li>{{ step | ticks }}</li>{% endfor %}
          </ol>
          {% if d.diff %}
          <pre class="diff">{% for kind, line in d.diff %}<span class="{{ kind }}">{{ line }}</span>{% endfor %}</pre>
          {% endif %}
          <button class="banish" type="button">Send {{ d.p.demon }} away</button>
        </div>
      </div>
    </article>
    {% else %}
    <p class="none">No demon could be proven. The patient is well.</p>
    {% endfor %}
  </section>

  {% if spared %}
  <section id="spared">
    <p class="kicker">Questioned and sent away</p>
    <h2>The spared</h2>
    <p class="intro">The detectors suspected these demons, but after questioning the evidence was too weak to name them.</p>
    <ul class="spared">
      {% for s in spared %}
      <li>{{ s.mask }}<div><strong>{{ s.name }}</strong>{{ s.summary }}</div></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section id="kola" class="reveal">
    <p class="kicker">Kola Sanniya</p>
    <div class="mask sway">{{ kola_mask }}</div>
    <h2>The leader of the demons</h2>
    <p class="root">{{ r.kola_sanniya.root_cause | ticks }}</p>
    <p class="explanation">{{ r.kola_sanniya.explanation | ticks }}</p>
    <div class="verse">
      <p class="si" lang="si">{{ r.kola_sanniya.verse_sinhala }}</p>
      <p class="tr">{{ r.kola_sanniya.verse_transliteration }}</p>
      <p class="en">{{ r.kola_sanniya.verse_english }}</p>
    </div>
  </section>
</main>

<footer>
  <h2>About the ritual</h2>
  <p>
    Sanni Yakuma is a traditional healing ritual of southern and western Sri Lanka, performed from
    dusk to dawn. It opens with the Ata Paliya, eight dances that bless the patient. Then, in the
    Daha Ata Sanniya, masked dancers portray the eighteen Sanni demons, each believed to cause a
    particular illness. The demons appear one by one, first frightening, then humiliated as comic
    figures, and are persuaded to leave the patient. Maha Kola Sanniya, the chief disease-demon,
    comes last; old masks show him surrounded by his eighteen attendant demons. The ritual is still
    performed today, mostly along the south coast, though more often as a cultural performance than
    as an exorcism.
  </p>
  <p>
    This page borrows the ritual's shape, not its sacred purpose. The humour is aimed at the code
    sicknesses, as the ritual itself mocks the demons, never at the tradition or the people who keep it.
    Read more: <a href="https://en.wikipedia.org/wiki/Sanni_Yakuma">Sanni Yakuma on Wikipedia</a>, and
    the <a href="https://collection.sciencemuseumgroup.org.uk/objects/co124339/polychrome-mask-representing-maha-kola-sanniya-chief-disease-demon">Maha Kola Sanniya mask</a>
    in the Science Museum Group collection.
  </p>

  <h2>How this exorcism was performed</h2>
  <ul>
    <li>Eighteen plain detectors read the code (no AI) and collected evidence: files, lines, numbers.</li>
    <li>{{ r.model }}, an open Gemma model, read that evidence and wrote the diagnosis, the monologues and the cures.</li>
    <li>Any demon or evidence Gemma named that the detectors had not found was thrown out. Code fixes are shown only if their lines really exist in the code.</li>
    {% if r.rejected %}<li>Thrown out this time: {{ r.rejected | join("; ") }}.</li>{% endif %}
    <li>The masks are original drawings made in code for this project, not copies of real masks.</li>
  </ul>
  <p>Made with <a href="https://github.com/dhananjaya-hbc/sanni-yakuma">sanni-yakuma</a>, performed {{ date }}.</p>
</footer>

<script>
(function () {
  var items = document.querySelectorAll(".reveal");
  if (!("IntersectionObserver" in window)) {
    items.forEach(function (el) { el.classList.add("seen", "lit"); });
    return;
  }
  var lampIndex = 0;
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      var el = e.target;
      el.classList.add("seen");
      if (el.classList.contains("lamp")) {
        // Light the lamps one after another, as in the opening dances.
        setTimeout(function () { el.classList.add("lit"); }, 250 + 300 * (lampIndex++ % 8));
      }
      io.unobserve(el);
    });
  }, { threshold: 0.15 });
  items.forEach(function (el) { io.observe(el); });
})();

/* Send a demon away: smoke, departure, and one fewer demon on the stage. */
(function () {
  var remaining = document.querySelector(".remaining");
  var count = remaining ? parseInt(remaining.getAttribute("data-count"), 10) : 0;
  var still = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll(".banish").forEach(function (button) {
    button.addEventListener("click", function () {
      var card = button.closest(".demon");
      if (card.classList.contains("banished")) return;
      card.classList.add("banished");
      var name = card.querySelector("h3").textContent.replace(" Sanniya", "");
      button.textContent = name + " has been sent away";
      button.disabled = true;
      if (!still) {
        var mask = card.querySelector(".mask");
        for (var i = 0; i < 6; i++) {
          var puff = document.createElement("span");
          puff.className = "puff";
          puff.style.setProperty("--dx", (Math.random() * 120 - 50).toFixed(0) + "px");
          puff.style.setProperty("--dy", (-40 - Math.random() * 90).toFixed(0) + "px");
          puff.style.animationDelay = (i * 0.12).toFixed(2) + "s";
          mask.appendChild(puff);
        }
      }
      if (remaining) {
        count -= 1;
        remaining.textContent = count === 0
          ? "Every demon has left the patient. Only their leader remains."
          : count + (count === 1 ? " demon remains." : " demons remain.") + " Read each cure, then send the demon away.";
        if (count === 0) document.body.classList.add("all-gone");
      }
    });
  });
})();

{% include "_living.js" %}
</script>
</body>
</html>
